{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "lifecycle": "lazy"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "lifecycle": "lazy"
    },
    "context-mode": {
      "command": "context-mode"
    },
    "searchcode": {
      "url": "https://api.searchcode.com/v1/mcp"
    }
  }
}